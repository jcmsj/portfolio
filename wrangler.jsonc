{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Assets-only Worker: no `main` script — every request is served from
  // static assets, unmatched paths fall back to index.html (SPA).
  "name": "portfolio",
  "compatibility_date": "2026-09-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
